# Development overrides (copy to backend/.env). Defaults already match
# docker-compose.yml, so this file is optional.
ENVIRONMENT=develop
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_DB=brain
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
REDIS_URL=redis://localhost:6389/0

# Telegram bot (optional): run `python manage.py telegram_poll` to receive its
# messages locally. See docs/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email (optional): password reset links. Off while EMAIL_PROVIDER is empty.
# See docs/deployment.md, Email.
EMAIL_PROVIDER=
EMAIL_FROM=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
