# Production environment for docker-compose.production.yml.
# Copy to stack.env (never commit it) or paste into Portainer's stack env.

# Version of the published images, e.g. 0.10.0. Empty: the latest release.
# Not used when building from source (docker-compose.build.yml).
BRAINBRO_VERSION=

# Hostname(s) BrainBro is opened on, comma-separated. With Caddy, separate
# them with a comma and a space.
APP_HOSTNAMES=brainbro.example.com
# Host port the api container is published on (what a tunnel or proxy reaches).
APP_PORT=8420
# Address the port is published on. Empty: every interface. 127.0.0.1 keeps it
# on this machine, for a tunnel or proxy running on it.
APP_BIND=
# false only on a local network without TLS, opened as http://<address>:<port>.
# Leave it on behind a tunnel or proxy that serves HTTPS.
APP_HTTPS=true
# What is in front of the app, for rate limits to see each visitor's address:
# cloudflare (Cloudflare Tunnel), caddy, or none (reached directly). With
# none behind a proxy, all visitors share one limit.
APP_PROXY=none

# openssl rand -base64 48
SECRET_KEY=CHANGE_ME

POSTGRES_DB=brain
POSTGRES_USER=brain
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Created on first deploy if it does not exist. Changing it later does nothing:
# change the password from the admin instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=

TIME_ZONE=UTC
# Number of daily database dumps kept in the backups volume.
BACKUP_RETENTION=14
# Largest file accepted by capture, in bytes (50 MB). Cloudflare Tunnel caps
# requests at 100 MB.
UPLOAD_MAX_SIZE=52428800
# The most each user may store, in MB (10240 is 10 GB). Empty: no quota. The
# admin can set another one per user in /admin/, on their profile.
STORAGE_QUOTA=
# Largest Obsidian vault zip accepted by "Import from Obsidian", in bytes
# (100 MB, Cloudflare Tunnel's cap).
IMPORT_MAX_SIZE=104857600
# Where users can get the code this server runs, linked from the About dialog.
# If you run a modified version, the AGPL asks you to point it at your source.
SOURCE_CODE_URL=https://github.com/TheBrainBro/brainbro
# Telegram bot (optional, see docs/telegram.md): the token and username
# BotFather gives you. Without them the bot is off, unless an admin sets it
# up in Settings, Telegram, which wins over these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Where Telegram sends the bot's messages. Empty: the first APP_HOSTNAMES
# over HTTPS, or else the public address set in Settings when it is HTTPS.
# Telegram only delivers to HTTPS addresses.
TELEGRAM_WEBHOOK_URL=
# Email (optional, see docs/deployment.md, Email): password reset links and
# invitations. Off while EMAIL_PROVIDER is empty. Providers: mailgun. It can be
# set in the app instead, in Settings, Server, Email, which then takes over.
EMAIL_PROVIDER=
# Who the email comes from. Empty: BrainBro <noreply@MAILGUN_DOMAIN>.
EMAIL_FROM=
# Mailgun: a sending API key, the sending domain, and its region (us or eu).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# Posts from X embedded in notes (optional, see docs/deployment.md#embed-host):
# a hostname of their own, e.g. embed.example.com, pointing at this server like
# APP_HOSTNAMES. Empty: links to X show as cards.
EMBED_HOSTNAME=

# Blogs on their owners' own domains (optional, see docs/blogs.md).
# The host their CNAME points at; empty: the host BrainBro is opened on.
SITE_CNAME_TARGET=
# The server's public IPv4, shown as an A record for root domains
# (example.com) that can't have a CNAME. Empty behind a tunnel.
SITE_IPV4=
