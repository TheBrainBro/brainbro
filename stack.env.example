# Production environment for docker-compose.production.yml.
# Copy to stack.env (never commit it) or paste into Portainer's stack env.

# Public hostname(s) served by the Cloudflare Tunnel, comma-separated.
APP_HOSTNAMES=brainbro.example.com
# Host port the api container is published on (tunnel target).
APP_PORT=8420

# openssl rand -base64 48
SECRET_KEY=CHANGE_ME

POSTGRES_DB=brain
POSTGRES_USER=brain
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Created on first deploy if it does not exist. Changing it later does nothing:
# change the password from the admin instead.
ADMIN_USERNAME=carlos
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=

TIME_ZONE=Europe/Madrid
# Number of daily database dumps kept in the backups volume.
BACKUP_RETENTION=14
# Largest file accepted by capture, in bytes (50 MB). Cloudflare Tunnel caps
# requests at 100 MB.
UPLOAD_MAX_SIZE=52428800
# Largest Obsidian vault zip accepted by "Import from Obsidian", in bytes
# (100 MB, Cloudflare Tunnel's cap).
IMPORT_MAX_SIZE=104857600
# Telegram bot (optional, see docs/telegram.md): the token and username
# BotFather gives you. Without them the bot is off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Blogs on their owners' own domains (optional, see docs/blogs.md).
# The host their CNAME points at; empty: the host BrainBro is opened on.
SITE_CNAME_TARGET=
# The server's public IPv4, shown as an A record for root domains
# (example.com) that can't have a CNAME. Empty behind a tunnel.
SITE_IPV4=
